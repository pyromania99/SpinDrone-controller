{
    "name": "Pegasus | Spin Drone Controller (Linux)",
    "privileged": true,
    "remoteUser": "container_user",
    "updateRemoteUserUID": true,
    "build": {
        "dockerfile": "../../Dockerfile",
        "context": "${localWorkspaceFolder}"
    },
    "workspaceFolder": "/workspace/spin-drone-controller",
    "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=/workspace/spin-drone-controller",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "esbenp.prettier-vscode",
                "eamodio.gitlens",
                "ms-iot.vscode-ros",
                "ms-toolsai.jupyter",
                "mechatroner.rainbow-csv",
                "ms-azuretools.vscode-docker",
                "twxs.cmake",
                "ms-vscode.cmake-tools",
                "redhat.vscode-yaml",
                "smilerobotics.urdf",
                "betwo.b2-catkin-tools",
                "zachflower.uncrustify",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "QT_QPA_PLATFORM": "xcb",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "NVIDIA_VISIBLE_DEVICES": "all"
    },
    "runArgs": [
        "--gpus=all",
        "--privileged",
        "-e", "DISPLAY=${localEnv:DISPLAY}",
        "-e", "QT_QPA_PLATFORM=xcb",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix"
    ],
    "initializeCommand": "xhost +local:docker",
    "postCreateCommand": "",
    "features": {},
    "mounts": [
        {
            "type": "bind",
            "source": "${localWorkspaceFolder}/.vscode",
            "target": "${containerWorkspaceFolder}/.vscode"
        }
    ]
}
