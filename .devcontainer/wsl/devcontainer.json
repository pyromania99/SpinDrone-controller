{
    "name": "Pegasus | WSL Spin Drone Controller",
    "privileged": true,
    "remoteUser": "container_user",
    "updateRemoteUserUID": true,
    "build": {
        "dockerfile": "../../Dockerfile",
        "context": "${localWorkspaceFolder}"
    },
    "workspaceFolder": "/workspace/spin-drone-controller",
    "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=/workspace/spin-drone-controller",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "esbenp.prettier-vscode",
                "eamodio.gitlens",
                "ms-iot.vscode-ros",
                "ms-toolsai.jupyter",
                "mechatroner.rainbow-csv",
                "ms-azuretools.vscode-docker",
                "twxs.cmake",
                "ms-vscode.cmake-tools",
                "redhat.vscode-yaml",
                "smilerobotics.urdf",
                "betwo.b2-catkin-tools",
                "zachflower.uncrustify",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "QT_QPA_PLATFORM": "xcb",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "LD_LIBRARY_PATH": "/usr/lib/wsl/lib",
        "MESA_D3D12_DEFAULT_ADAPTER_NAME": "NVIDIA",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}"
    },
    "runArgs": [
        "--gpus=all",
        "--privileged",
        "--net=host",
        "--device=/dev/dxg",
        "-v", "/usr/lib/wsl:/usr/lib/wsl",
        "-v", "/mnt/wslg:/mnt/wslg",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix"
    ],
    "initializeCommand": "command -v xhost >/dev/null 2>&1 && xhost +local:docker || true",
    "postCreateCommand": "",
    "features": {},
    "mounts": [
        {
            "type": "bind",
            "source": "${localWorkspaceFolder}/.vscode",
            "target": "${containerWorkspaceFolder}/.vscode"
        }
    ]
}